{
  "name": "prato-cheio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prato Cheio — conecta doadores de alimentos a ONGs. Projeto da disciplina Análise, Projeto e Desenvolvimento Ágil.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "db:migrar": "node --env-file-if-exists=.env scripts/db-migrar.js",
    "db:migrar-dados-sqlite": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning scripts/migrar-dados-sqlite.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13"
  }
}
