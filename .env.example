# Copie para .env (o .env não vai para o Git). `npm start`, `npm run dev` e
# `npm run db:migrar` leem este arquivo automaticamente (node --env-file-if-exists).

# Banco de desenvolvimento (serviço `db` do docker-compose.yml).
DATABASE_URL=postgres://pratocheio:pratocheio@localhost:5432/pratocheio

# Banco usado por `npm test` (serviço `db-teste`). Se não for definido, os testes
# usam este mesmo endereço como padrão (ver vitest.config.js).
TEST_DATABASE_URL=postgres://pratocheio:pratocheio@localhost:5433/pratocheio_teste

# Porta HTTP da aplicação.
PORT=3000

# Só para `npm run db:migrar-dados-sqlite`: arquivo SQLite de origem.
# DATABASE_FILE=dados.sqlite

# Portas no host usadas pelo docker-compose.yml. Mude se a 5432/5433 já estiver
# ocupada na sua máquina (e ajuste a porta em DATABASE_URL/TEST_DATABASE_URL).
# DB_PORTA=5432
# DB_TESTE_PORTA=5433
